# Optional settings for source builds. `cp .env.example .env` to use them.
# Do not add server-side secrets to this file.

# Optional: signed macOS builds with in-app browser passkeys.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile

# Optional: the Hub's public https:// origin. Copied thread and prompt links, MCP thread links,
# and `t3 auth` links point at it; without it they use the address the client reached the Hub on.
# T3CODE_PUBLIC_URL=https://hub.example.com
# The mobile build's link domain (universal links / app links), usually the same origin.
# EXPO_PUBLIC_T3CODE_PUBLIC_URL=https://hub.example.com
